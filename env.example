# Скопируйте этот файл в .env и укажите свой ник FOMO.
# Изменения настроек вступают в силу после перезапуска программы.

# Парсер в Docker (настройки нужны только тому, кто запускает парсер).
WORKERS=4
MAX_RPM=18

# Подписки через установленный Google Chrome.
FOLLOW_ACCOUNT=ArmedSlimPony
FOLLOW_WORKERS=2
FOLLOW_RPM=10

# Оставьте 0: с сохранённой сессией FOMO пока не загружался в скрытом Chrome.
FOLLOW_HEADLESS=0

# Пустое значение — непрерывная работа. Число — столько профилей за один запуск.
FOLLOW_MAX_PROFILES=

# Файлы с профилями и прогрессом. Обычно менять не нужно.
FOLLOW_SOURCE=data/all_profiles.csv
FOLLOW_DB=follow_data/follow_state.sqlite3
FOLLOW_PROFILE_DIR=follow_data/chrome_profile

# Укажите путь только если Chrome установлен не в стандартном месте.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
